  "constraints": [
    {
      "definition": "CHECK ((attempt_count > 0))",
      "name": "pro_payment_orders_attempt_count_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((binding_source = ANY (ARRAY['intent'::text, 'legacy'::text, 'unresolved'::text, 'support'::text])))",
      "name": "pro_payment_orders_binding_source_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK (((bound_user_id IS NULL) OR (bound_user_id ~ '^[A-Za-z0-9][A-Za-z0-9@._+-]{0,127}$'::text)))",
      "name": "pro_payment_orders_bound_user_id_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((order_id ~ '^[A-Za-z0-9_-]{6,128}$'::text))",
      "name": "pro_payment_orders_order_id_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((payment_status = ANY (ARRAY['unknown'::text, 'paid'::text, 'refunded'::text, 'cancelled'::text])))",
      "name": "pro_payment_orders_payment_status_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "PRIMARY KEY (order_id)",
      "name": "pro_payment_orders_pkey",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((provider = 'afdian'::text))",
      "name": "pro_payment_orders_provider_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((status = ANY (ARRAY['activated'::text, 'unresolved'::text, 'ineligible'::text])))",
      "name": "pro_payment_orders_status_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK (((verified_binding_reference IS NULL) = (binding_reference_verified_at IS NULL)))",
      "name": "pro_payment_orders_verified_reference_check",
      "table": "pro_payment_orders"
    },
    {
      "definition": "CHECK ((next_page > 0))",
      "name": "pro_payment_reconciliation_state_next_page_check",
