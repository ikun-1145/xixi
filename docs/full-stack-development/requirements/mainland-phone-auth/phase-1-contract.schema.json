{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:sunland:phone-auth:phase-1",
  "title": "Internal Worker SMS verification contract; no public REST route or identity grant",
  "$defs": {
    "sendInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone",
        "purpose",
        "turnstile_token"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^(\\+86)?1[3-9][0-9]{9}$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "login",
            "bind",
            "change",
            "unbind",
            "reauth"
          ]
        },
        "turnstile_token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      }
    },
    "checkInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phone",
        "purpose",
        "challenge_id",
        "code"
      ],
      "properties": {
        "phone": {
          "type": "string",
          "pattern": "^(\\+86)?1[3-9][0-9]{9}$"
        },
        "purpose": {
          "type": "string",
          "enum": [
            "login",
            "bind",
            "change",
            "unbind",
            "reauth"
          ]
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{6}$"
        }
      }
    },
    "sendResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "challenge_id",
        "expires_in",
        "retry_after"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "challenge_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "expires_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "retry_after": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600
        }
      }
    },
    "checkResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "success",
        "verified"
      ],
      "properties": {
        "success": {
          "const": true
        },
        "verified": {
          "const": true
        }
      }
    },
    "errorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "error",
        "code"
      ],
      "properties": {
        "error": {
          "type": "string",
          "maxLength": 100
        },
        "code": {
          "type": "string",
          "enum": [
            "SMS_DISABLED",
            "SMS_CONFIG",
            "INVALID_REQUEST",
            "REAUTH_REQUIRED",
            "CAPTCHA_FAILED",
            "RATE_LIMITED",
            "BUDGET_EXCEEDED",
            "SERVICE_UNAVAILABLE",
            "CHALLENGE_INVALID",
            "CHALLENGE_EXPIRED",
            "CHALLENGE_USED",
            "CODE_INVALID",
            "PROVIDER_RATE_LIMITED",
            "PROVIDER_AUTH",
            "PROVIDER_CONFIG",
            "PROVIDER_UNAVAILABLE",
            "UPSTREAM_TIMEOUT",
            "UPSTREAM_UNAVAILABLE",
            "UPSTREAM_PROTOCOL"
          ]
        }
      }
    }
  }
}
