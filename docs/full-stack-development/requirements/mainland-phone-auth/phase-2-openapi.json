  "components": {
    "securitySchemes": {
      "ApplicationJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "existing Sunland application JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "code",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "code": {
            "type": "string",
            "enum": [
              "SMS_DISABLED",
              "SMS_CONFIG",
              "INVALID_REQUEST",
              "REAUTH_REQUIRED",
              "CAPTCHA_FAILED",
              "RATE_LIMITED",
              "BUDGET_EXCEEDED",
              "SERVICE_UNAVAILABLE",
              "CHALLENGE_INVALID",
              "CHALLENGE_EXPIRED",
              "CHALLENGE_USED",
              "CODE_INVALID",
              "PROVIDER_RATE_LIMITED",
              "PROVIDER_AUTH",
              "PROVIDER_CONFIG",
              "PROVIDER_UNAVAILABLE",
              "UPSTREAM_TIMEOUT",
              "UPSTREAM_UNAVAILABLE",
              "UPSTREAM_PROTOCOL",
              "IDENTITY_DISABLED",
              "IDENTITY_CONFIG",
              "IDENTITY_UNAVAILABLE",
              "UNAUTHORIZED",
              "ACCOUNT_NOT_ACTIVE",
              "ACCOUNT_BANNED",
              "PHONE_KEY_MISMATCH",
              "PHONE_CONFLICT",
              "PHONE_ALREADY_BOUND",
              "PHONE_NOT_BOUND",
              "REAUTH_INVALID",
              "ALTERNATIVE_LOGIN_REQUIRED",
              "OPERATION_CONFLICT",
              "DELETION_CONFLICT",
              "REGISTRATION_DISABLED",
              "CANARY_LIMITED",
              "CANARY_DENIED",
              "RELEASE_CONFIG"
            ]
          },
          "error": {
            "type": "string"
          }
        }
      },
      "SendResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "success",
          "challenge_id",
          "expires_in",
          "retry_after"
        ],
        "properties": {
          "success": {
            "const": true
          },
          "challenge_id": {
            "type": "string",
            "format": "uuid"
          },
          "expires_in": {
            "type": "integer",
            "minimum": 0,
            "maximum": 300
          },
          "retry_after": {
            "type": "integer",
            "minimum": 0,
            "maximum": 600
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token",
          "user",
          "onboarding",
          "is_new_user"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "email"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "onboarding": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "step"
                ],
                "properties": {
                  "version": {
                    "const": 0
                  },
                  "step": {
                    "enum": [
                      1,
                      2,
                      3
                    ]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "version",
                  "step"
                ],
                "properties": {
                  "version": {
                    "const": 1
                  },
                  "step": {
                    "const": 3
                  }
                }
              }
            ]
          },
          "is_new_user": {
            "type": "boolean"
          }
        }
      },
      "StatusResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "bound",
          "phone",
          "has_email"
        ],
        "properties": {
          "bound": {
            "type": "boolean"
          },
          "phone": {
            "type": [
              "string",
              "null"
            ],
            "description": "仅掩码，例如 +86 *******0000"
          },
          "has_email": {
            "type": "boolean",
            "description": "邮箱存在，不代表已完成本次身份验证"
          }
        }
      },
      "GrantResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reauth_token",
          "expires_in"
        ],
        "properties": {
          "reauth_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "expires_in": {
            "const": 300
          }
        }
      },
      "MutationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "const": true
          }
        }
      },
      "DeletionAuthorization": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ok",
          "deletion_job_id",
          "deletion_token",
          "expires_in"
        ],
        "properties": {
          "ok": {
            "const": true
          },
          "deletion_job_id": {
            "type": "string",
            "format": "uuid"
          },
          "deletion_token": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
          },
          "expires_in": {
            "const": 600
          }
        }
      }
    }
  }
}
