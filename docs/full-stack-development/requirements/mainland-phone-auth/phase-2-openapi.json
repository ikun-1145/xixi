{
  "openapi": "3.1.0",
  "info": {
    "title": "Sunland phone authentication Phase 2",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.sunland.dev",
      "description": "契约目标；本轮未部署"
    }
  ],
  "paths": {
    "/v1/phone/send-code": {
      "post": {
        "operationId": "phone_send_code",
        "security": [],
        "description": "send-code仅login用途匿名，其余须现有应用JWT及必要reauth_token。所有手机号与token均禁止日志。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "phone": {
                    "type": "string",
                    "pattern": "^(\\+86)?1[3-9][0-9]{9}$"
                  },
                  "purpose": {
                    "type": "string",
                    "enum": [
                      "login",
                      "bind",
                      "change",
                      "reauth",
                      "unbind"
                    ]
                  },
                  "turnstile_token": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048
                  },
                  "reauth_token": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
                  }
                },
                "required": [
                  "phone",
                  "purpose",
                  "turnstile_token"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功，遵循此响应schema；不表示接口已部署",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendResult"
                }
              }
            }
          },
          "400": {
            "description": "INVALID_REQUEST/验证码失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "UNAUTHORIZED: JWT缺失/验签失败/过期",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "ACCOUNT_NOT_ACTIVE/ACCOUNT_BANNED/REAUTH_INVALID/ALTERNATIVE_LOGIN_REQUIRED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "PHONE_CONFLICT/PHONE_ALREADY_BOUND/PHONE_NOT_BOUND/OPERATION_CONFLICT/DELETION_CONFLICT/CHALLENGE_USED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "请求超过8192 bytes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "RATE_LIMITED/BUDGET_EXCEEDED/PROVIDER_RATE_LIMITED",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "默认关闭/配置缺失/PHONE_KEY_MISMATCH/数据库或供应商状态不明",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "UPSTREAM_TIMEOUT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "新路由仅支持POST；OPTIONS委托既有Worker",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "UPSTREAM_PROTOCOL: 供应商响应格式或未知验证结果，失败关闭",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
